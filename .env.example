# URL of the ledger-api service (see ../ledger-api). Defaults to
# http://localhost:3001 in code if this file/var is absent.
VITE_API_URL=http://localhost:3001

# Testing from another device on your network (e.g. a phone hitting the Vite
# dev server's LAN URL): "localhost" always means the device loading the
# page, not your dev machine. Point this at your computer's LAN IP instead,
# e.g. VITE_API_URL=http://192.168.1.50:3001, and start the API with
# `npm run dev` (Express binds to all interfaces by default).
