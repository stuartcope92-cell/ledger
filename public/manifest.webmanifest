{
  "name": "Ledger",
  "short_name": "Ledger",
  "description": "A private gym & nutrition tracker. No feeds, no ads.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0F1115",
  "theme_color": "#0F1115",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Log exercise",
      "short_name": "Lift",
      "description": "Jump straight to the Lift tab",
      "url": "./?tab=lift",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Add meal",
      "short_name": "Food",
      "description": "Jump straight to the Food tab",
      "url": "./?tab=food",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    }
  ]
}
