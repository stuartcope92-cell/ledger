# ── Ledger API configuration ──────────────────────────────────
# Copy to `.env` and fill in what you have. The server runs with NONE of these
# set — Open Food Facts (text search + barcode) needs no key. Add keys to unlock
# better text parsing and photo recognition.

# Server
PORT=3001
ALLOWED_ORIGIN=*            # set to your app's origin in production

# ── Text search (optional) ────────────────────────────────────
# Nutritionix: natural-language parsing ("2 eggs and toast"). Free tier available.
# https://developer.nutritionix.com/
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=

# ── Photo recognition (optional) ──────────────────────────────
# Choose ONE. If more than one is set, PHOTO_PROVIDER decides; otherwise
# auto-detected in the order: logmeal, foodvisor, gemini.
PHOTO_PROVIDER=            # "logmeal", "foodvisor", or "gemini"

# LogMeal (paid) — https://logmeal.com/api
LOGMEAL_TOKEN=

# Foodvisor (paid) — https://www.foodvisor.io/en/vision/
FOODVISOR_KEY=

# Gemini (free-tier eligible) — a general vision model prompted for the same
# structured output, not a food-specific API. Get a key at
# https://aistudio.google.com. Free-tier request limits vary by model/account
# and change over time — check the actual current limit for your key in AI
# Studio rather than assuming a fixed number.
GEMINI_API_KEY=
GEMINI_MODEL=              # optional, defaults to "gemini-2.5-flash"
